# Điền rồi lưu file. File này KHÔNG được đưa lên GitHub.

# Key OpenAI: platform.openai.com/api-keys → Create new secret key
OPENAI_API_KEY=

# (Tuỳ chọn) Key Claude làm não dự phòng khi OpenAI hỏng: console.anthropic.com → API Keys.
# Điền thì chạy thêm 1 lần: npm install (trong thư mục agent). Bỏ trống = không dùng dự phòng.
ANTHROPIC_API_KEY=

# Token bot Telegram: nhắn @BotFather → /newbot → làm theo → copy token
TELEGRAM_BOT_TOKEN=

# Tên DID bạn đã tạo bằng: node scripts/generate-did.js <ten>
DID_LABEL=
